{
  "manifest_version": 3,
  "name": "YT Sub Length Underscore",
  "version": "1.1",
  "description": "Replace short YouTube caption words with underscores.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Sub Length Underscore"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}